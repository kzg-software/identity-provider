##########################################################################
# Auth-System – Umgebung für den Docker-Betrieb
#
#   cp .env.docker.example .env
#   # Werte unten anpassen, dann:
#   docker compose up -d
#
# Diese Datei wird von docker compose gelesen (Variablen-Interpolation)
# UND als .env in den Container eingehängt. Container-"environment:" hat
# Vorrang vor Werten in dieser Datei.
##########################################################################

# --- Image ---------------------------------------------------------------
# NUR für den Registry-Weg (docker-compose.yml) nötig: Pfad zum von der CI
# gebauten Image, komplett KLEINGESCHRIEBEN. Für die lokalen Bau-Wege
# (docker-compose.sqlite.yml / -f docker-compose.build.yml) leer/auskommentiert
# lassen – dann wird "auth-system:local" gebaut.
# APP_IMAGE=ghcr.io/kzg-software/identity-provider:latest

# Host-Port, unter dem der Container erreichbar ist (dahinter Reverse Proxy).
APP_PORT=8080

# --- Anwendung ---------------------------------------------------------
APP_NAME="Auth System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Öffentliche URL, unter der Nutzer/Clients das System erreichen (HTTPS!):
APP_URL=https://auth.example.com

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

# Release-Stand: Das Image setzt APP_VERSION bereits auf den Git-Tag. Nur
# überschreiben, wenn du ein eigenes Image ohne diesen Build-Arg nutzt.
# APP_VERSION=

# Update-Prüfung gegen GitHub (Administration -> Aktualisierungen). Läuft immer;
# optionales Token nur bei privatem Repo oder gegen API-Rate-Limits.
# UPDATE_GITHUB_TOKEN=

# --- Reverse Proxy ---------------------------------------------------
# Dem/den vorgelagerten Proxy/Proxies vertrauen (X-Forwarded-*).
# "*" ist ok, wenn der Container NUR über den Proxy erreichbar ist
# (z.B. eigenes Docker-Netz, Port nicht nach außen gemappt).
TRUSTED_PROXIES=*

# --- Datenbank (Standard: MariaDB-Service "db" aus docker-compose.yml) --
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=auth_system
DB_USERNAME=auth_system
DB_PASSWORD=bitte-aendern-langes-passwort
# nur für den MariaDB-Container:
DB_ROOT_PASSWORD=bitte-aendern-anderes-langes-passwort

# Beim ersten Start automatisch migrieren (Tabellen anlegen).
AUTO_MIGRATE=true

# --- Sessions / Cache / Queue (DB-basiert, kein Redis nötig) ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Logging ---------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- E-Mail (optional; sonst wird nur ins Log geschrieben) ------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=auth@example.com
MAIL_FROM_NAME="Auth System"

BCRYPT_ROUNDS=12
